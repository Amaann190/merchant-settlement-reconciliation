        "lineageTag": "1ec53b72-67c1-4164-811d-5e3407f59ca8",
        "measures": [
          {
            "name": "Payouts",
            "expression": "COUNTROWS(Payouts)",
            "formatString": "#,0",
            "lineageTag": "d502e17b-0c27-49ac-92aa-70ee91e943db"
          },
          {
            "name": "Payouts needing follow-up",
            "expression": "CALCULATE([Payouts], KEEPFILTERS(Payouts[Status] <> \"CREDITED\"))",
            "formatString": "#,0",
            "lineageTag": "ded45237-43fa-4866-bedc-166696505a7b"
          },
          {
            "name": "Gateway paid INR",
            "expression": "SUM(Payouts[Gateway net])",
            "formatString": "#,0.00",
            "lineageTag": "ddb9c9b3-bf60-4e86-a65f-02fcfe126be5"
          },
          {
            "name": "Bank received INR",
            "expression": "COALESCE(SUM(Payouts[Bank credit]), 0)",
            "formatString": "#,0.00",
            "lineageTag": "0a8d30ce-7285-498a-944b-9e105a6926d9"
          },
          {
            "name": "Payout gap INR",
            "expression": "[Gateway paid INR] - [Bank received INR]",
            "formatString": "#,0.00",
            "lineageTag": "df9878a8-8efc-43f8-97a1-51f32b6dbf29"
          }
        ],
        "partitions": [
