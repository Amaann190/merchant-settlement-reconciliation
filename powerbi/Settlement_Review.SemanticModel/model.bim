            "sourceColumn": "deducted_charges",
            "summarizeBy": "sum"
          }
        ],
        "lineageTag": "c434ed23-b075-4930-928d-169be509f1af",
        "measures": [
          {
            "name": "Orders",
            "expression": "COUNTROWS(Ledger)",
            "formatString": "#,0",
            "lineageTag": "74bd36c3-e32f-4733-9a43-1d8769d0936c"
          },
          {
            "name": "Reconciled share",
            "expression": "DIVIDE(CALCULATE([Orders], KEEPFILTERS(Ledger[Outcome] IN {\"MATCHED\", \"REFUNDED\"})), [Orders], 0)",
            "formatString": "0.0%",
            "lineageTag": "125e63ae-766a-4914-89f3-a0d0332280ae"
          },
          {
            "name": "Matched share",
            "expression": "DIVIDE(CALCULATE([Orders], KEEPFILTERS(Ledger[Outcome] = \"MATCHED\")), [Orders], 0)",
            "formatString": "0.0%",
            "lineageTag": "dfea6835-a6dd-4e56-984b-4a905a54d4d0"
          },
          {
            "name": "Shortfall INR",
            "expression": "COALESCE(SUMX(FILTER(Ledger, Ledger[Difference] > 0), Ledger[Difference]), 0)",
            "formatString": "#,0.00",
            "lineageTag": "7ca6a259-6319-4309-8b43-ef3609e0cdcb"
          },
          {
            "name": "Overpaid INR",
            "expression": "COALESCE(-SUMX(FILTER(Ledger, Ledger[Difference] < 0), Ledger[Difference]), 0)",
            "formatString": "#,0.00",
            "lineageTag": "b906b4c3-fe30-4a05-9b1b-d454c0544581"
          },
          {
            "name": "In transit INR",
            "expression": "COALESCE(CALCULATE(SUM(Ledger[Expected net]), KEEPFILTERS(Ledger[Outcome] = \"IN_TRANSIT\")), 0)",
            "formatString": "#,0.00",
            "lineageTag": "a2188dec-c00f-41c1-904a-a6b4724534a4"
          },
          {
            "name": "Total recoverable INR",
            "description": "Order-level shortfall plus bank short-credits that cannot be assigned to one order. A missing payout is already counted through its orders.",
            "expression": "[Shortfall INR] + COALESCE(CALCULATE(SUM(Payouts[Difference]), Payouts[Status] = \"SHORT_CREDITED\"), 0)",
            "formatString": "#,0.00",
            "lineageTag": "0bba5027-7584-4867-ab2e-05f290bb91b6"
          },
          {
            "name": "Recoverable by outcome",
            "expression": "VAR s = [Shortfall INR] RETURN IF(s > 0, s)",
            "formatString": "#,0",
            "lineageTag": "d11e6a79-fc0b-4707-9be7-75763c3b41b9"
          },
          {
            "name": "Exception orders",
            "expression": "CALCULATE([Orders], KEEPFILTERS(NOT (Ledger[Outcome] IN {\"MATCHED\", \"REFUNDED\", \"IN_TRANSIT\", \"PAYMENT_FAILED\"})))",
            "formatString": "#,0",
            "lineageTag": "1fafdb23-cdd3-4d62-844e-e4c8a7dbc2ae"
          }
        ],
        "partitions": [
          {
            "name": "Ledger",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/reconciliation_report.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Selected = Table.SelectColumns(Headers, {\"order_id\", \"status\", \"expected_net\", \"actual_net\", \"difference\", \"exception_flags\", \"payment_id\", \"captured_on\", \"settlement_id\", \"utr\", \"contract_charges\", \"deducted_charges\"}),",
                "    Clean = Table.ReplaceValue(Selected, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Selected)),",
                "    Typed = Table.TransformColumnTypes(Clean, {{\"order_id\", type text}, {\"status\", type text}, {\"expected_net\", Currency.Type}, {\"actual_net\", Currency.Type}, {\"difference\", Currency.Type}, {\"captured_on\", type date}, {\"contract_charges\", Currency.Type}, {\"deducted_charges\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
